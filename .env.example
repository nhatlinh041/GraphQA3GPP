# GraphQA3GPP environment variables — copy to .env and adjust.

# Neo4j connection (the knowledge graph)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Ollama endpoint — base URL only, no /api/* suffix.
# Point it at another host if Ollama runs elsewhere, e.g. http://192.168.1.14:11434
OLLAMA_URL=http://localhost:11434

# Directory of processed JSON chunks read by scripts/rebuild-kg.sh
# (output of document_processing/download_and_process_3gpp.py).
JSON_DIR=3GPP_JSON_DOC/processed_json_v6

# Cloudflared tunnel (optional, public demo only) — set the three variables and run
# `bash scripts/gen-cloudflared.sh` to generate cloudflared-demo.yml from the template.
CLOUDFLARED_TUNNEL_ID=your-tunnel-uuid
CLOUDFLARED_CREDENTIALS_FILE=/path/to/your-tunnel-uuid.json
CLOUDFLARED_HOSTNAME=your-domain.com
